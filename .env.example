# UniVerse Environment Configuration Example
# Copy to .env for local server credentials

# Server Port
PORT=3000

# Optional: Gemini API Key for server-side AI Confession Analysis
# When not provided, the application automatically uses the local rule-engine fallback classifier
GEMINI_API_KEY=

# Optional: Supabase or Firebase configurations for production multi-device sync
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
